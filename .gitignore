/Results/*
/__pycache__/*
.vscode/settings.json
/junk/
# Excel temp lock files and dev artifacts
~$*.xlsx
~$*.xlsb
rme_table.xlsx
rme_table_forecast.xlsx

# Bootstrap-estimater regnes på nytt ved hver kjøring (IRiR.R: BS.new = 1) og
# skrives over av R-pipeline. Verdiene er stokastiske, så filen ga konflikt ved
# hver merge. Den ligger fortsatt lokalt og gjenbrukes hvis BS.new settes til 0.
/Data/Bootstrap/*.csv

# Grunnlagsdata regenereres av R (Generer grunnlagsdata / RME-kjøring). Den
# opplastede fila forbrukes av en kjøring, og _generert er bare en ren kopi av
# samme R-utdata — ingen av dem er kildedata.
/Data/grunnlagsdata_uploaded.csv
/Data/grunnlagsdata_generert.csv

# Kildedokumenter (analyser, presentasjoner) holdes utenfor repoet — de er store
# binærfiler som ikke kan diffes. Legg dem gjerne i mappa lokalt.
*.pdf



ir_tabell (26).csv
Fusjonscase_TS+Tn+Elvia.xlsx

# Overstyringsfiler skrevet av appen (opplasting, redigering eller sonepriser).
# De er brukerens egne tall for én kjøring, ikke kildedata. Sonekartet utledes
# av standardfilen og bygges på nytt hvis det mangler.
/Data/BaseData/*_override.xlsx
/Data/BaseData/kraftpris_soner_map.csv
